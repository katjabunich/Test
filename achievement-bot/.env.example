# В этой установке секреты бота хранятся НЕ в env, а в таблице achievements.config
# (у Edge Functions здесь нет отдельного хранилища секретов). Заполняются один раз
# вот таким SQL — НЕ коммить реальные значения в git:
#
#   insert into achievements.config
#     (telegram_bot_token, owner_telegram_id, webhook_secret, cron_secret,
#      anthropic_api_key, anthropic_model)
#   values
#     ('123456:ABC-DEF...',          -- токен от @BotFather (/newbot)
#      0,                            -- 0 = первого, кто напишет /start, бот сам закрепит владельцем
#      'длинная-случайная-строка-1', -- подпись webhook'а
#      'длинная-случайная-строка-2', -- защита cron-функции
#      'sk-ant-...',                 -- ключ Claude API (опционально, для /итоги)
#      'claude-haiku-4-5-20251001')
#   on conflict (id) do update set
#      telegram_bot_token = excluded.telegram_bot_token,
#      owner_telegram_id  = excluded.owner_telegram_id,
#      webhook_secret     = excluded.webhook_secret,
#      cron_secret        = excluded.cron_secret,
#      anthropic_api_key  = excluded.anthropic_api_key,
#      anthropic_model    = excluded.anthropic_model;
#
# SUPABASE_URL и SUPABASE_SERVICE_ROLE_KEY подставляются в функции автоматически.
