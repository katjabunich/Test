# Секреты Edge Functions (задаются командой `supabase secrets set` или в дашборде).
# В git НЕ коммитим — только этот пример.

# От @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Твой постоянный Telegram user ID (узнаётся при первом /start, см. README)
OWNER_TELEGRAM_ID=000000000

# Случайная длинная строка — подпись webhook'а (придумать любую)
TELEGRAM_WEBHOOK_SECRET=change-me-long-random

# Случайная длинная строка — защита cron-функции
CRON_SECRET=change-me-long-random

# Claude API (опционально — для /итоги). Без него запись и сводки работают.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Подставляются Supabase автоматически, локально — из проекта:
# SUPABASE_URL=...
# SUPABASE_SERVICE_ROLE_KEY=...
